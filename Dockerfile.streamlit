FROM python:3.12-slim

# uv para instalación reproducible desde el lockfile
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Instalar dependencias del sistema mínimas para psycopg2 + python-docx
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# Copiar lockfile primero para aprovechar el cache de Docker capas
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Copiar código fuente y assets
COPY src/ ./src/
COPY templates/ ./templates/
COPY source_prompts/ ./source_prompts/

# Directorio de output — en producción se monta como bind mount
RUN mkdir -p /app/output

# Puerto configurable; default 8503 para no chocar con los otros proyectos del sistema
ENV STREAMLIT_PORT=8503
EXPOSE ${STREAMLIT_PORT}

# Healthcheck liviano
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${STREAMLIT_PORT}/_stcore/health')"

CMD ["sh", "-c", "uv run streamlit run src/ic/presentation/app.py \
    --server.port=${STREAMLIT_PORT} \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --browser.gatherUsageStats=false"]
