# =============================================================================
# Sistema de Informes de Inteligencia Competitiva — Variables de entorno
# Copiar a .env y completar los valores. Nunca commitear .env.
# =============================================================================

# --- Base de datos (instancia pgvector compartida en puerto 5434) ---
# Si usas el docker-compose.yml de este repo, completa POSTGRES_* y construye DATABASE_URL con esos valores.
# Si ya tienes una instancia compartida corriendo, solo actualiza DATABASE_URL.
POSTGRES_USER=ic_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=informes_ic_db
DATABASE_URL=postgresql://ic_user:changeme@localhost:5434/informes_ic_db
DB_SCHEMA=informes_ic

# --- Ollama (corre en el host, no dockerizado) ---
# En Docker: cambiar a http://172.17.0.1:11434 (gateway Docker) o http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- UI Streamlit ---
# Puerto de la app web. 8503 elegido para no chocar con sacd (8502) ni Streamlit default (8501).
STREAMLIT_PORT=8503

# --- Routing de modelos (ADR-002): nombres aquí, nunca en código ---
LLM_LOCAL_EMBED_MODEL=nomic-embed-text:latest
LLM_LOCAL_DRAFT_MODEL=qwen2.5:7b
LLM_LOCAL_ANALYTIC_MODEL=qwen2.5:7b

# --- OpenRouter (escalado API — ADR-002, ADR-006) ---
# POLÍTICA (ADR-006): solo modelos free o económicos (<$0.20/MTok in).
# Prohibido usar modelos top-tier (claude-*, gpt-4*, gemini-ultra, o1/o3).
# Obtener clave en https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Tier free primario: caps analíticos (Cap 2, 3, 4) — $0, rate-limited
LLM_API_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Tier free alternativo: fallback si el primario llega a rate limit — $0
LLM_API_FREE_ALT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tier síntesis free: caps de síntesis (5, 6, Resumen) — mayor capacidad, $0
LLM_API_SYNTH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tier económico: último fallback si free falla — <$0.20/MTok in
LLM_API_PAID_MODEL=google/gemma-3-27b-it

# Legado — mantener para compatibilidad con .env existentes
LLM_API_PROVIDER=openrouter
LLM_API_ANALYTIC_MODEL=
LLM_API_KEY=

# --- Routing de modelos local — Ollama en WSL (máx 8GB VRAM — no superar 7B sin validación)
LLM_LOCAL_TIMEOUT=300        # segundos; qwen3:8b con contexto amplio puede superar 120s

# --- Control de presupuesto (ADR-002) ---
LLM_MAX_TOKENS_INPUT=8000
LLM_MAX_TOKENS_OUTPUT=4000
LLM_BUDGET_LIMIT_USD=1.0
LLM_CIRCUIT_BREAKER_MAX_RETRIES=3

# --- Retrieval (ADR-001) ---
# 0.6 recalibrado en DT-049 (a 0.70 la capa sectorial colapsaba a 1–3 docs; rodilla 0.55–0.60).
RAG_SIMILARITY_THRESHOLD=0.6
# top_k 10→16 + min_distinct_docs 5→8 (DT-049): palanca real de diversidad de referencias.
RAG_TOP_K=16
RAG_MIN_DISTINCT_DOCS=8

# --- Fuentes automáticas (ADR-003) ---
# Email para el polite pool de OpenAlex (recomendado, no obligatorio)
OPENALEX_EMAIL=
# API key de Tavily para búsqueda web (opcional)
TAVILY_API_KEY=

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO
